image: 
  tag: {{ .StateValues.ci.tag }}

enable_db_migrations: true

params:
  REDIS_HOST: "redis-master"
  REDIS_PORT: "6379"
  REDIS_PASSWORD: ""
  PORT: 3000
  DATABASE_URL: "postgresql://postgres:secretString123@postgres-postgresql:5432/incentives"
  JWT_SECRET: FkaGHXoq32rYBcEHwAn2rkhawtUCe4sE
  APP_URL : "https://incentives-pr-{{ .StateValues.ci.prNumber }}.rdx-works-main.extratools.works"
  APPLICATION_NAME: "incentives-pr-{{ .StateValues.ci.prNumber }}"
  WORKERS_API_BASE_URL: "http://worker:3003"
  DAPP_DEFINITION_ADDRESS: "account_rdx129zzrj4mwjwec8e6rmsvcz0hx4lp7uj3kf73w8rd2fek4cryaemewh"


secrets:
  - external_secret_name: incentives-radix-charts-key
    env_variable: "RADIX_CHARTS_AUTHORIZATION_TOKEN"
    aws_secret_name: "rdx-works-main/eks/incentives/dev/secrets"
    aws_secret_key: "api_key"
    secret_key: "api_key"
  - external_secret_name: incentives-token-price-service-key
    env_variable: "TOKEN_PRICE_SERVICE_API_KEY"
    aws_secret_name: "rdx-works-main/eks/incentives/dev/secrets"
    aws_secret_key: "token_price_service_key"
    secret_key: "token_price_service_key"


ingress:
  enabled: true
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/auth-signin: https://oauth2-proxy.rdx-works-main.extratools.works/oauth2/start
    nginx.ingress.kubernetes.io/auth-url: https://oauth2-proxy.rdx-works-main.extratools.works/oauth2/auth
  hosts:
    - host: incentives-pr-{{ .StateValues.ci.prNumber }}.rdx-works-main.extratools.works
      paths:
        - path: /
          pathType: ImplementationSpecific

autoscaling:
  enabled: false

resources:
  requests:
    cpu: 50m
    memory: 128Mi

metrics:
  alert_labels:
    cluster: rdx-works-main-dev
    env: prs
