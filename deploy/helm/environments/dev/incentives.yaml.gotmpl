image: 
  tag: {{ .StateValues.ci.tag }}

enable_db_migrations: true

params:
  REDIS_HOST: "redis-master"
  REDIS_PORT: "6379"
  REDIS_PASSWORD: ""
  PORT: 3000
  WORKERS_API_BASE_URL: "http://worker:3003"
  APP_URL: https://incentives-dev.rdx-works-main.extratools.works
  APPLICATION_NAME: "incentives-dev"

secrets:
  - external_secret_name: incentives-postgres-url
    env_variable: "DATABASE_URL"
    aws_secret_name: "rdx-works-main-dev/eks/incentives/dev/postgres"
    aws_secret_key: "database-url"
    secret_key: "database-url"
  - external_secret_name: incentives-radix-charts-key
    env_variable: "RADIX_CHARTS_AUTHORIZATION_TOKEN"
    aws_secret_name: "rdx-works-main/eks/incentives/dev/secrets"
    aws_secret_key: "api_key"
    secret_key: "api_key"
  - external_secret_name: incentives-token-price-service-key
    env_variable: "TOKEN_PRICE_SERVICE_API_KEY"
    aws_secret_name: "rdx-works-main/eks/incentives/dev/secrets"
    aws_secret_key: "token_price_service_key"
    secret_key: "token_price_service_key"


ingress:
  enabled: true
  annotations:
    kubernetes.io/ingress.class: nginx
  hosts:
    - host: incentives-dev.rdx-works-main.extratools.works
      paths:
        - path: /
          pathType: ImplementationSpecific

replicaCount: 1

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 2
  targetCPUUtilizationPercentage: 70
  targetMemoryUtilizationPercentage: 70

resources:
  requests:
    cpu: 50m
    memory: 256Mi

metrics:
  alert_labels:
    cluster: rdx-works-main-dev
    env: dev

serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: 'arn:aws:iam::308190735829:role/incentives-dev-role'
