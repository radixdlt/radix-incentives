image: 
    tag: {{ .StateValues.ci.tag }}

params:
  REDIS_HOST: "redis-master"
  REDIS_PORT: "6379"
  REDIS_PASSWORD: ""
  LOG_LEVEL: trace
  EVENT_WORKER_CONCURRENCY: 20
  TRANSACTION_WORKER_CONCURRENCY: 20
  GATEWAY_URL: "https://private-link-active-mainnet.rtlj-prod.extratools.works"
  OTLP_BASE_URL: http://opentelemetry-collector.monitoring:4318
  OTEL_RESOURCE_ATTRIBUTES: "service.namespace={{ .Release.Namespace }},deployment.environment={{ .Release.Namespace }}"
  TOKEN_PRICE_SERVICE_URL: "https://token-price-service.radixdlt.com/price/historicalPrice"
  SNAPSHOT_BATCH_SIZE: 1000
  VAULT_BASE_URL: "https://vault.vault.svc.cluster.local:8200"
  VAULT_KEY_NAME: "incentives-xrd-distributer"
  VAULT_TOKEN_FILE: "/vault/secrets/token"

podAnnotations:
  vault.hashicorp.com/agent-inject: 'true'
  vault.hashicorp.com/agent-inject-token: 'true'
  vault.hashicorp.com/auth-type: 'aws'
  vault.hashicorp.com/auth-path: 'auth/aws'
  vault.hashicorp.com/auth-config-type: 'iam'
  vault.hashicorp.com/role: 'role-incentives-dev'
  vault.hashicorp.com/service: 'https://vault.vault.svc.cluster.local:8200'
  vault.hashicorp.com/tls-skip-verify: 'true'

  
secrets:
  - external_secret_name: workers-postgres-url
    env_variable: "DATABASE_URL"
    aws_secret_name: "rdx-works-main-dev/eks/incentives/dev/postgres"
    aws_secret_key: "database-url"
    secret_key: "database-url"
  - external_secret_name: workers-token-price-service-key
    env_variable: "TOKEN_PRICE_SERVICE_API_KEY"
    aws_secret_name: "rdx-works-main/eks/incentives/dev/secrets"
    aws_secret_key: "token_price_service_key"
    secret_key: "token_price_service_key"

ingress:
  enabled: false

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 2
  targetCPUUtilizationPercentage: 70
  targetMemoryUtilizationPercentage: 70

resources:
  requests:
    cpu: 50m
    memory: 512Mi

affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          labelSelector:
            matchExpressions:
              - key: app
                operator: In
                values:
                  - incentives-worker
          topologyKey: "kubernetes.io/hostname"

metrics:
  enabled: true
  port: 9210
  alert_labels:
    cluster: rdx-works-main-dev
    env: dev

serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: 'arn:aws:iam::308190735829:role/incentives-dev-role'
